{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PMV-PWA-WRAPPED-KEK-V1.schema.json",
  "title": "PMV PWA Wrapped Production KEK Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_id",
    "format_version",
    "vault_id",
    "key_generation",
    "kdf",
    "kdf_opslimit",
    "kdf_memlimit_bytes",
    "kdf_output_bytes",
    "salt_b64",
    "aead",
    "nonce_b64",
    "aad",
    "wrapped_kek_ciphertext_b64",
    "created_at_utc"
  ],
  "properties": {
    "format_id": {"const": "PMV-PWA-WRAPPED-KEK-V1"},
    "format_version": {"const": 1},
    "vault_id": {"type": "string", "minLength": 1},
    "key_generation": {"type": "integer", "minimum": 1},
    "kdf": {"const": "Argon2id13"},
    "kdf_opslimit": {"const": 3},
    "kdf_memlimit_bytes": {"const": 536870912},
    "kdf_output_bytes": {"const": 32},
    "salt_b64": {"type": "string", "minLength": 1},
    "aead": {"const": "XChaCha20-Poly1305-IETF"},
    "nonce_b64": {"type": "string", "minLength": 1},
    "aad": {"type": "string", "minLength": 1},
    "wrapped_kek_ciphertext_b64": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
